---
import type { Status } from '../lib/statuses';

interface Props {
  status: Status;
  class?: string;
}

const { status, class: className } = Astro.props;
---

<span class:list={['items-center gap-3 text-gray-600 dark:text-gray-400', className]}>
  <span class="inline-flex items-center gap-1" title="Likes">
    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
    <span class="sr-only">Likes:</span>{status.data.favorite_count}
  </span>
  <span class="inline-flex items-center gap-1" title="Retweets">
    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4" /><path d="M3 11v-1a4 4 0 0 1 4-4h14" /><path d="m7 22-4-4 4-4" /><path d="M21 13v1a4 4 0 0 1-4 4H3" /></svg>
    <span class="sr-only">Retweets:</span>{status.data.retweet_count}
  </span>
</span>
