{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweets",
  "compatibility_date": "2026-06-08",
  "observability": { "enabled": true },

  // Build the site before deploying. Adding this config made Cloudflare stop
  // auto-detecting Jekyll and running its build, so run it explicitly here;
  // it outputs to _site/tweets (per destination in _config.yml).
  "build": { "command": "bundle exec jekyll build" },

  // Jekyll builds into _site/tweets (see destination in _config.yml). Point
  // the asset root at the PARENT (_site) so files serve at /tweets/* and match
  // the site's baseurl. Pointing this at _site/tweets would serve at root again
  // and re-break every link.
  "assets": {
    "directory": "_site"
  },

  // The public route ben.balter.com/tweets* is managed in the Cloudflare
  // dashboard (Worker -> Settings -> Domains & Routes), not here: the Workers
  // Builds deploy token lacks permission to create Worker routes, which would
  // otherwise fail every deploy. The route only needs to be set once.

  "workers_dev": true
}
