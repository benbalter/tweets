{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweets",
  "compatibility_date": "2026-06-08",
  "observability": { "enabled": true },

  // Build the site before deploying. Workers Builds doesn't detect Astro once
  // this config exists, so run the build explicitly.
  "build": { "command": "npm run build" },

  // Astro builds into dist/tweets (outDir in astro.config.mjs). Point the asset
  // root at the PARENT (dist) so files serve at /tweets/* and match the site's
  // base. Pointing this at dist/tweets would serve at root and break every link.
  "assets": {
    "directory": "dist"
  },

  // The public route ben.balter.com/tweets* is managed in OpenTofu, in
  // benbalter/dns (zone.balter.com.tf), not here: the Workers Builds deploy
  // token lacks permission to create Worker routes, which would otherwise fail
  // every deploy. Change the route there, not in the dashboard.

  "workers_dev": true
}
